{
    "env": {
        "CLAUDE_CODE_TASK_LIST_ID": "{{ cookiecutter.project_slug }}"
    },
    "permissions": {
        "allow": [
            "Bash(ty check:*)",
            "Bash(ls:*)",
            "Read",
            "Edit",
            "Write",
            "Glob",
            "Grep",
            "Bash(cd: *)",
            "Bash(python:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git status:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(find:*)",
            "Bash(uv run:*)",
            "Bash(uv add:*)",
            "WebSearch"
        ],
        "deny": [
            "Bash(rm -rf:*)",
            "Bash(git push:*)",
            "Bash(git reset --hard:*)"
        ]
    }
}
