{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    { "type": "command", "command": ".claude/scripts/protect-files.sh" }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    { "type": "command", "command": ".claude/scripts/block-destructive.sh" }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    { "type": "command", "command": ".claude/scripts/biome-format.sh" },
                    { "type": "command", "command": ".claude/scripts/test-runner.sh", "timeout": 30, "async": true }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    { "type": "command", "command": ".claude/scripts/biome-check.sh" },
                    { "type": "command", "command": ".claude/scripts/typecheck.sh", "timeout": 30 }
                ]
            }
        ]
    }
}
