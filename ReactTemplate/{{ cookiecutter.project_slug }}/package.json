{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "{{ cookiecutter.initial_version }}",
  "private": true,
  "description": "{{ cookiecutter.description }}",
  "author": "{{ cookiecutter.full_name }} <{{ cookiecutter.email }}>",
  "license": "{{ cookiecutter.license }}",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "biome:check": "biome lint",
    "jsdoc": "eslint --config eslint.jsdoc.cjs src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "{{ cookiecutter.node_package_manager }}{% if cookiecutter.node_package_manager == 'bun' %} pm{% endif %} audit",
    "check": "biome check && tsc --noEmit && eslint --config eslint.jsdoc.cjs src/ && vitest run --coverage && {{ cookiecutter.node_package_manager }}{% if cookiecutter.node_package_manager == 'bun' %} pm{% endif %} audit",
    "ci": "biome check && tsc --noEmit && eslint --config eslint.jsdoc.cjs src/ && vitest run --coverage && {{ cookiecutter.node_package_manager }}{% if cookiecutter.node_package_manager == 'bun' %} pm{% endif %} audit"{% if cookiecutter.enable_precommit == 'yes' %},
    "prepare": "husky"{% endif %}
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"{% if cookiecutter.include_tanstack_query == "yes" %},
    "@tanstack/react-query": "^5.0.0"{% endif %}{% if cookiecutter.include_zustand == "yes" %},
    "zustand": "^5.0.0"{% endif %}{% if cookiecutter.include_router == "yes" %},
    "react-router": "^7.0.0"{% endif %}{% if cookiecutter.include_shadcn == "yes" %},
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"{% endif %}
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@total-typescript/tsconfig": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^50.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"{% if cookiecutter.include_playwright == "yes" %},
    "@playwright/test": "^1.49.0"{% endif %}{% if cookiecutter.enable_precommit == "yes" %},
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"{% endif %}
  }{% if cookiecutter.enable_precommit == "yes" %},
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write", "eslint --config eslint.jsdoc.cjs --fix"],
    "*.{json,md,css}": ["biome format --write"]
  }{% endif %}
}
