FROM docker/sandbox-templates:claude-code

USER agent

# Install Bun (project uses Bun, not npm)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/home/agent/.bun/bin:$PATH"

# Upgrade Claude Code to latest
RUN curl -fsSL https://claude.ai/install.sh | bash

USER root

# Git identity for AFK commits (separate from auth — GH_TOKEN handles push)
RUN git config --global user.name "claude-afk[bot]" && \
    git config --global user.email "claude-afk[bot]@users.noreply.github.com"

# Install Lefthook for pre-commit quality gates (biome check --staged)
RUN curl -fsSL https://get.lefthook.com | bash -s -- -b /usr/local/bin

# BASH_ENV: Load GH_TOKEN for subprocesses (git push, gh CLI)
ENV BASH_ENV=/home/agent/.env_loader
RUN cat > /home/agent/.env_loader <<'EOF'
if [ -f .env ]; then
  for _var in GH_TOKEN; do
    _val=$(grep "^${_var}=" .env | cut -d= -f2-)
    if [ -n "$_val" ]; then export "${_var}=${_val}"; fi
  done
  unset _var _val
fi
EOF

# Claude wrapper: inject CLAUDE_CODE_OAUTH_TOKEN before real binary
RUN cat > /usr/local/bin/claude <<'WRAPPER'
#!/bin/bash
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -f .env ]; then
  CLAUDE_CODE_OAUTH_TOKEN=$(grep "^CLAUDE_CODE_OAUTH_TOKEN=" .env | cut -d= -f2-)
  export CLAUDE_CODE_OAUTH_TOKEN
fi
exec /home/agent/.local/bin/claude "$@"
WRAPPER
RUN chmod +x /usr/local/bin/claude

ENV PATH=/usr/local/bin:$PATH

USER agent
